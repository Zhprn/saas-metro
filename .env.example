# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Environment variables for the application
NODE_ENV=development

# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/news_portal"

# Authentication
JWT_SECRET=your_super_secret_key_here

# System email (account activation / verification emails sent to new users)
# Separate from the customer "Connect Gmail" feature. Uses Gmail SMTP with an
# App Password (https://myaccount.google.com/apppasswords, requires 2FA).
VERIFY_FROM_EMAIL=noreply@example.com
VERIFY_TOKEN_TTL_MINUTES=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_16_char_app_password